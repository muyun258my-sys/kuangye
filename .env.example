# 复制为 .env 后按需填写；不填 LLM_API_KEY 时自动使用离线模板。

# ---- LLM（阶段 3，OpenAI 兼容接口）----
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---- 可选数据源 ----
# LME 没有免费 API；填了 key 后价格 provider 会优先尝试 metals-api，失败再降级 mock。
METALS_API_KEY=

# ---- 离线 / 调试 ----
# MINING_OFFLINE=1 时不发任何网络请求，全部使用 fixtures / mock。
# MINING_OFFLINE=1
# LOG_LEVEL=INFO
